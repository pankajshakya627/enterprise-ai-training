# MongoDB Atlas (cluster tier must support Vector Search)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net
MONGODB_DB=nexaassist
MONGODB_COLLECTION=policy_chunks
VECTOR_INDEX_NAME=policy_chunks_v1

# OpenAI (Week 1 uses embeddings only)
OPENAI_API_KEY=sk-...
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BATCH_SIZE=100

# Chunking (tunable without a redeploy)
CHUNK_MAX_CHARACTERS=1200

# Corpus-wide metadata stamped on every chunk
INSTITUTION=NexaBank
JURISDICTION=IN
CONFIDENTIALITY_LEVEL=internal

# Logging
LOG_LEVEL=INFO

# Datadog (needs a running Datadog Agent when enabled)
DD_TRACE_ENABLED=false
DD_SERVICE=nexaassist-ingestion
DD_ENV=dev

# LangSmith
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=nexaassist-phase1
